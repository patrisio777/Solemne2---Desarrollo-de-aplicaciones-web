# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - BACKEND CAFETERÍA "PARAÍSO DEL CAFÉ"
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=django-insecure-#@8hb89r%kbtr2wq8fw+8^9)^*s$^z#ayale3gb9%n*@csdjkn
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS RELACIONAL: PostgreSQL (PSQL)
# ------------------------------------------------------------------------------
# Cambiar USE_POSTGRESQL a True para conectar con tu PostgreSQL (local o remoto)
# Si es False, Django utilizará SQLite como respaldo para desarrollo local inmediato.
USE_POSTGRESQL=True
DB_NAME=paraiso_cafe_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS NO RELACIONAL: MongoDB Atlas
# ------------------------------------------------------------------------------
# Obtén tu URI en: MongoDB Atlas -> Clusters -> Connect -> Drivers (Python)
# Ejemplo: mongodb+srv://<usuario>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=paraiso_cafe_nosql

# ------------------------------------------------------------------------------
# 3. CORS (Comunicación con Frontend React)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
